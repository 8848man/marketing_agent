# Optional keys for the dashboard. Copy to .env in this project root.
# The app stores UI-entered keys here and never includes real values in this example.
# A nonempty local .env value takes precedence over the process environment.
# Leave unused provider keys empty. YouTube key is only for optional public comments.
YOUTUBE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
